{
  "name": "os-practice-web",
  "version": "1.0.0",
  "private": true,
  "description": "Local, private Moodle-style one-question-per-page practice test simulator with server-side timer and auto-marking.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --no-warnings server/index.ts",
    "dev": "node --no-warnings --watch server/index.ts",
    "import": "node --no-warnings server/cli-import.ts",
    "import:fixtures": "node --no-warnings server/cli-import.ts --fixtures",
    "test": "node --no-warnings --test --test-concurrency=1 \"tests/unit/*.test.ts\"",
    "test:e2e": "node --no-warnings --test --test-concurrency=1 \"tests/e2e/*.test.ts\"",
    "screenshots": "node --no-warnings scripts/screenshots.ts",
    "build:pages": "node --no-warnings scripts/build-pages.ts"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0"
  }
}
